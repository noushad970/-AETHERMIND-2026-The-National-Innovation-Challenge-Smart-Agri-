# Copy this file to .env and fill in your own values. .env is ignored by git.
# Run:   flutter run --dart-define-from-file=.env

# Google Gemini key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional backend (see SmartAgriServer/). Leave empty to call Gemini directly.
SERVER_BASE_URL=
SMART_AGRI_SECRET=

# Firebase API keys (Firebase console > Project settings)
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
FIREBASE_WEB_API_KEY=
